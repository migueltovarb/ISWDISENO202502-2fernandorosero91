{
	"info": {
		"_postman_id": "vehiculos-api-collection",
		"name": "Vehiculos API",
		"description": "Colección completa para probar el API REST de Vehículos con MongoDB",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Listar Todos los Vehículos",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8080/vehiculos",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"vehiculos"
					]
				},
				"description": "Obtiene la lista completa de todos los vehículos registrados"
			},
			"response": []
		},
		{
			"name": "Buscar Vehículo por ID",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8080/vehiculos/{{vehicleId}}",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"vehiculos",
						"{{vehicleId}}"
					]
				},
				"description": "Busca un vehículo específico por su ID. Reemplaza {{vehicleId}} con un ID válido."
			},
			"response": []
		},
		{
			"name": "Crear Vehículo - Toyota",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"if (pm.response.code === 201) {",
							"    var jsonData = pm.response.json();",
							"    pm.collectionVariables.set(\"vehicleId\", jsonData.id);",
							"    pm.test(\"Vehículo creado exitosamente\", function () {",
							"        pm.expect(jsonData.id).to.exist;",
							"    });",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"marca\": \"Toyota\",\n    \"modelo\": \"Corolla\",\n    \"color\": \"Blanco\",\n    \"placa\": \"ABC-123\",\n    \"año\": 2023\n}"
				},
				"url": {
					"raw": "http://localhost:8080/vehiculos",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"vehiculos"
					]
				},
				"description": "Crea un nuevo vehículo Toyota Corolla. El ID generado se guarda automáticamente en la variable {{vehicleId}}."
			},
			"response": []
		},
